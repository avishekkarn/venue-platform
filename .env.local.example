# ============================================================
# Environment variables — EXAMPLE FILE
# ============================================================
# This file is committed to the repository. It contains
# placeholder values only. To use it locally, copy it to
# .env.local and fill in real values.
#
# Never commit .env.local. It is listed in .gitignore.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/venue_dev"

# ------------------------------------------------------------
# Session
# ------------------------------------------------------------
# Secret used to sign session cookies.
# Generate a strong secret with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string"

# ------------------------------------------------------------
# Development Mobile Testing (D-17.4)
# ------------------------------------------------------------
# LAN IP origin used by /dev/qr for scanning with physical devices.
# Format: http://<LAN_IP>:<PORT>
DEV_LAN_ORIGIN="http://192.168.1.51:3000"

