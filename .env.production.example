# ============================================================
# PRODUCTION environment variables — EXAMPLE FILE
# ============================================================
# This file documents the production deployment's environment.
# It is committed to the repository and contains placeholder
# values only.
#
# The real production .env is created on the venue's server by
# the developer at onboarding. It is NEVER committed.
#
# See docs/SYSTEM.md §15.4.1 (production DB user + SSL) and
# docs/DEPLOYMENT.md (Phase 10.7) for the deployment procedure.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Production PostgreSQL connection string.
#
# Required settings:
#   - USER is the dedicated `venue_prod` role, NOT the `postgres`
#     superuser and NOT the developer's local account.
#   - HOST is the production database host (not localhost).
#   - sslmode=require is MANDATORY. The production runtime refuses
#     to boot if this is missing. See src/infrastructure/db/client.ts.
#   - DATABASE is the venue's production database name.
#
# The `venue_prod` role's grants are documented in
# docs/SYSTEM.md §15.4.1. In summary: SELECT, INSERT, UPDATE on
# the venue's tables; no DROP, no ALTER, no CREATE, no DELETE
# on historical rows.
DATABASE_URL="postgresql://venue_prod:REPLACE_WITH_REAL_PASSWORD@db.example.com:5432/venue_prod?sslmode=require"

# ------------------------------------------------------------
# Database connection pool
# ------------------------------------------------------------
# pg.Pool's maximum connection count.
#
# Recommended: 20 (matches D-15.4's 20-staff ceiling). A venue
# with more concurrent staff raises this. A malformed value falls
# back to 20 with a one-time server-side log.
DB_POOL_MAX=20

# ------------------------------------------------------------
# Session
# ------------------------------------------------------------
# Secret used to sign session cookies.
#
# MUST be a fresh, high-entropy value generated ON THE PRODUCTION
# SERVER, not copied from development. Generate it with:
#   openssl rand -base64 32
#
# Rotating this secret invalidates every active staff session
# (per D-3.3). Rotate only during a planned maintenance window.
SESSION_SECRET="REPLACE_WITH_FRESH_PRODUCTION_SECRET"

# ------------------------------------------------------------
# Audit log
# ------------------------------------------------------------
# Directory for the request-level JSON-lines audit log.
#
# MUST be a path the production process can write to. MUST be
# backed up per D-8.5 (30-day retention).
#
# Default: logs/audit
AUDIT_LOG_DIR=logs/audit

# ------------------------------------------------------------
# Development-only variables
# ------------------------------------------------------------
# DEV_LAN_ORIGIN and NEXT_ALLOWED_DEV_ORIGINS are development-only
# and are NOT used in production. Do not set them here.

